rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGlobalSuperAdmin() {
      return signedIn() && request.auth.token.email == 'shivsuri1@gmail.com';
    }

    function isPlatformOwner() {
      return signedIn() && (request.auth.token.platformOwner == true || isGlobalSuperAdmin());
    }

    function hasVerifiedEmail() {
      return signedIn() && (request.auth.token.email_verified == true || isGlobalSuperAdmin());
    }

    function hasOrgClaim() {
      return signedIn() && request.auth.token.orgId is string && request.auth.token.orgId.size() > 0;
    }

    function sameOrg(orgId) {
      return hasOrgClaim() && request.auth.token.orgId == orgId;
    }

    function isOrgAdmin(orgId) {
      return sameOrg(orgId) && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner'
      );
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function orgExists(orgId) {
      return exists(orgPath(orgId));
    }

    function orgIsSuspended(orgId) {
      return orgExists(orgId) && (
        get(orgPath(orgId)).data.suspended == true ||
        get(orgPath(orgId)).data.status == 'suspended'
      );
    }

    function canReadOrg(orgId) {
      return isPlatformOwner() || sameOrg(orgId);
    }

    function canWriteOrgAppData(orgId) {
      return hasVerifiedEmail() && sameOrg(orgId) && orgExists(orgId) && !orgIsSuspended(orgId);
    }

    function sameOrgProfile() {
      return signedIn() &&
        resource.data.orgId is string &&
        request.auth.token.orgId == resource.data.orgId;
    }

    function requestOwnProfileOrgIsValid() {
      return !request.resource.data.keys().hasAny(['orgId']) ||
        (request.resource.data.orgId is string && request.auth.token.orgId == request.resource.data.orgId);
    }

    function protectedUserFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'profilePicUrl',
        'toolPreferences',
        'fontSize',
        'fontFamily',
        'themeFont',
        'accentColor',
        'displayMode',
        'fontScale',
        'lastActive',
        'lastLogin',
        'lastLogout',
        'lastActiveGroupId'
      ]);
    }

    function userCreateDoesNotGrantPrivileges() {
      return request.resource.data.uid == request.auth.uid &&
        requestOwnProfileOrgIsValid() &&
        request.resource.data.isAdmin != true &&
        request.resource.data.platformOwner != true &&
        request.resource.data.roles == null;
    }

    function hasAuthedEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function authedEmail() {
      return request.auth.token.email;
    }

    function isOwnResource() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.userEmail == authedEmail() ||
        resource.data.senderEmail == authedEmail() ||
        resource.data.createdBy == authedEmail()
      );
    }

    function requestIsOwnResource() {
      return signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.createdByUid == request.auth.uid ||
        request.resource.data.userEmail == authedEmail() ||
        request.resource.data.senderEmail == authedEmail() ||
        request.resource.data.createdBy == authedEmail()
      );
    }

    function canReadTaskMessage() {
      return resource.data.isTask != true ||
        (hasAuthedEmail() && (
          resource.data.senderEmail == authedEmail() ||
          (resource.data.taskData.assignees is list && resource.data.taskData.assignees.hasAny([authedEmail()])) ||
          (resource.data.taskData.visibleTo is list && resource.data.taskData.visibleTo.hasAny([authedEmail()]))
        ));
    }

    function taskMessageWriteIsScoped() {
      return request.resource.data.isTask != true ||
        (
          request.resource.data.taskData.assignees is list &&
          request.resource.data.taskData.visibleTo is list &&
          request.resource.data.taskData.visibleTo.hasAll([request.resource.data.senderEmail]) &&
          request.resource.data.taskData.visibleTo.hasAll(request.resource.data.taskData.assignees)
        );
    }

    function messageCreateIsSafe(orgId) {
      return canWriteOrgAppData(orgId) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderEmail == authedEmail() &&
        request.resource.data.groupId is string &&
        request.resource.data.groupId.size() > 0 &&
        !request.resource.data.keys().hasAny([
          'orgId',
          'status',
          'sentAt',
          'deliveredAt',
          'deliveryStatus',
          'processedAt',
          'processedBy',
          'platformOwner',
          'isAdmin',
          'roles'
        ]) &&
        taskMessageWriteIsScoped();
    }

    function taskMessageIsCompleted() {
      return resource.data.isTask == true && resource.data.taskData.status == 'Completed';
    }

    function taskManagerCanEdit(orgId) {
      return isOrgAdmin(orgId) ||
        resource.data.senderEmail == authedEmail() ||
        resource.data.taskData.masterReviewerEmail == authedEmail();
    }

    function taskUpdateIsAllowedForStatus(orgId) {
      return resource.data.isTask != true ||
        (
          (
            !taskMessageIsCompleted() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions',
              'seenBy',
              'deliveredTo',
              'bookmarkedBy',
              'isPinned',
              'updatedAt'
            ])
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'text',
              'fileUrl',
              'storagePath',
              'fileName',
              'storedFileName',
              'fileType',
              'fileSize',
              'originalFileSize',
              'uploadedBy',
              'uploadedAt'
            ]) ||
            taskManagerCanEdit(orgId)
          )
        );
    }

    function messageUpdateIsSafe(orgId) {
      return canWriteOrgAppData(orgId) &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.senderEmail == resource.data.senderEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'isEdited',
          'editedAt',
          'reactions',
          'seenBy',
          'deliveredTo',
          'bookmarkedBy',
          'isPinned',
          'taskData',
          'taskDeadline',
          'taskAssignees',
          'fileUrl',
          'storagePath',
          'fileName',
          'storedFileName',
          'fileType',
          'fileSize',
          'originalFileSize',
          'uploadedBy',
          'uploadedAt',
          'updatedAt'
        ]) &&
        taskMessageWriteIsScoped() &&
        taskUpdateIsAllowedForStatus(orgId);
    }

    function scheduledCreateIsSafe(orgId) {
      return canWriteOrgAppData(orgId) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderEmail == authedEmail() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.groupId is string &&
        request.resource.data.groupId.size() > 0 &&
        !request.resource.data.keys().hasAny(['sentAt', 'processedAt', 'processedBy', 'deliveredAt', 'deliveryStatus']);
    }

    function scheduledUpdateIsSafe(orgId) {
      return canWriteOrgAppData(orgId) &&
        resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderUid == resource.data.senderUid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'scheduledFor',
          'scheduledAt',
          'taskData',
          'taskDeadline',
          'taskAssignees',
          'updatedAt'
        ]);
    }

    function userUpdateIsOwnSafeProfile(uid) {
      return request.auth.uid == uid && protectedUserFieldsUnchanged();
    }

    match /platform/config {
      allow read, write: if isPlatformOwner();
    }

    match /platform/{document=**} {
      allow read, write: if false;
    }

    match /subscriptionPackages/{packageId} {
      allow read: if signedIn();
      allow write: if isPlatformOwner();
    }

    match /subscriptionPackages/{packageId}/{document=**} {
      allow read, write: if isPlatformOwner();
    }

    match /organizations/{orgId} {
      allow get: if canReadOrg(orgId);
      allow list: if isPlatformOwner();
      allow create, update, delete: if isPlatformOwner();

      match /org_details/{detailsId} {
        allow read: if canReadOrg(orgId);
        allow write: if isPlatformOwner();
      }

      match /messages/{messageId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && canReadTaskMessage());
        allow create: if isPlatformOwner() || messageCreateIsSafe(orgId);
        allow update: if isPlatformOwner() || messageUpdateIsSafe(orgId);
        allow delete: if isPlatformOwner() || (canWriteOrgAppData(orgId) && (isOrgAdmin(orgId) || resource.data.senderUid == request.auth.uid));
      }

      match /scheduled_messages/{scheduleId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && (resource.data.senderUid == request.auth.uid || isOrgAdmin(orgId)));
        allow create: if isPlatformOwner() || scheduledCreateIsSafe(orgId);
        allow update: if isPlatformOwner() || scheduledUpdateIsSafe(orgId);
        allow delete: if isPlatformOwner() || (canWriteOrgAppData(orgId) && resource.data.senderUid == request.auth.uid && resource.data.status == 'pending');
      }

      match /groups/{groupId} {
        allow read: if canReadOrg(orgId);
        allow create: if isPlatformOwner() || (canWriteOrgAppData(orgId) && request.resource.data.createdBy == authedEmail());
        allow update: if isPlatformOwner() || canWriteOrgAppData(orgId);
        allow delete: if isPlatformOwner() || (canWriteOrgAppData(orgId) && isOrgAdmin(orgId));
      }

      match /notifications/{notificationId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && (resource.data.userId == request.auth.uid || isOrgAdmin(orgId)));
        allow create: if isPlatformOwner() || canWriteOrgAppData(orgId);
        allow update, delete: if isPlatformOwner() || (canWriteOrgAppData(orgId) && (resource.data.userId == request.auth.uid || isOrgAdmin(orgId)));
      }

      match /reminders/{reminderId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && (resource.data.userId == request.auth.uid || isOrgAdmin(orgId)));
        allow create: if isPlatformOwner() || (canWriteOrgAppData(orgId) && request.resource.data.userId == request.auth.uid);
        allow update, delete: if isPlatformOwner() || (canWriteOrgAppData(orgId) && (resource.data.userId == request.auth.uid || isOrgAdmin(orgId)));
      }

      match /workspace/{workspaceDocId} {
        allow read: if canReadOrg(orgId);
        allow write: if isPlatformOwner() || (canWriteOrgAppData(orgId) && isOrgAdmin(orgId));
      }

      match /workspace_tags/{tagId} {
        allow read: if canReadOrg(orgId);
        allow write: if isPlatformOwner() || (canWriteOrgAppData(orgId) && isOrgAdmin(orgId));
      }

      match /broadcast_acks/{ackId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && isOrgAdmin(orgId));
        allow create: if isPlatformOwner() || (canWriteOrgAppData(orgId) && request.resource.data.userEmail == authedEmail());
        allow update, delete: if false;
      }

      match /typing/{typingId} {
        allow read: if canReadOrg(orgId);
        allow create, update: if canWriteOrgAppData(orgId) && requestIsOwnResource();
        allow delete: if canWriteOrgAppData(orgId) && isOwnResource();
      }

      match /audit_logs/{auditId} {
        allow read: if isPlatformOwner() || (sameOrg(orgId) && isOrgAdmin(orgId));
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Legacy root app-data collections were migrated to organizations/{orgId}/...
    // Keep explicit deny rules so accidental root access is not hidden by the
    // catch-all deny at the end of this ruleset.
    match /workspace/{document=**} {
      allow read, write: if false;
    }

    match /groups/{document=**} {
      allow read, write: if false;
    }

    match /messages/{document=**} {
      allow read, write: if false;
    }

    match /broadcasts/{document=**} {
      allow read, write: if false;
    }

    match /audit_logs/{document=**} {
      allow read, write: if false;
    }

    match /notifications/{document=**} {
      allow read, write: if false;
    }

    match /reminders/{document=**} {
      allow read, write: if false;
    }

    match /workspace_tags/{document=**} {
      allow read, write: if false;
    }

    match /tenantInvitations/{invitationId} {
      allow get, list: if isPlatformOwner() || (
        signedIn() && (
          resource.data.email == request.auth.token.email ||
          resource.data.emailLower == request.auth.token.email
        )
      );
      allow create, update, delete: if isPlatformOwner();
    }

    match /users/{uid} {
      allow get: if isPlatformOwner() || (signedIn() && request.auth.uid == uid) || sameOrgProfile();
      allow list: if isPlatformOwner() || sameOrgProfile();
      allow create: if isPlatformOwner() || (signedIn() && request.auth.uid == uid && userCreateDoesNotGrantPrivileges());
      allow update: if isPlatformOwner() || (signedIn() && request.auth.uid == uid && userUpdateIsOwnSafeProfile(uid));
      allow delete: if isPlatformOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
