{
  "rules": {
    "typing": {
      "$orgId": {
        ".read": "auth != null && auth.token.orgId == $orgId",
        "$chatId": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && auth.token.orgId == $orgId",
            ".validate": "newData.hasChildren(['groupId', 'userId', 'name', 'clientTimestamp']) && newData.child('userId').val() == auth.uid && newData.child('groupId').isString() && newData.child('name').isString() && newData.child('clientTimestamp').isNumber()"
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
